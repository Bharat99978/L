<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#0D0D11"
    tools:context="com.network.nr.MainActivity">

    <!-- Title and Branding -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DravixIDE"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:layout_marginBottom="8dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Signal &amp; RadioInfo Utility"
        android:textColor="#C084FC"
        android:textSize="15sp"
        android:layout_marginBottom="36dp"
        android:gravity="center" />

    <!-- Information Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#181820"
        android:padding="22dp"
        android:layout_marginBottom="36dp"
        android:elevation="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shortcut Action"
            android:textColor="#C084FC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Direct shortcut to launch the Android RadioInfo configuration screen (com.android.phone.settings.RadioInfo) to manage mobile network settings."
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: Access may be restricted by device OEM firmware or carrier policies."
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Launch Button -->
    <Button
        android:id="@+id/launch_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Radio Info"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:textColor="#FFFFFF"
        app:backgroundTint="#9333EA"
        android:tag="launch_button" />

</LinearLayout>
