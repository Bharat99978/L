<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212"
    tools:context="com.network.nr.MainActivity">

    <!-- Premium Icon Area -->
    <ImageView
        android:id="@+id/icon_image"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_menu_info_details"
        app:tint="#00E676"
        android:contentDescription="Radio Info Icon" />

    <!-- Elegant Typography -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Radio Info"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Signal &amp; Network Configuration Utility"
        android:textColor="#B0BEC5"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"
        android:gravity="center" />

    <!-- Help/Information Card style layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="20dp"
        android:layout_marginBottom="32dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shortcut Action"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This application is a shortcut to open the hidden Android RadioInfo configuration screen (com.android.phone.settings.RadioInfo) to manage advanced cellular settings."
            android:textColor="#ECEFF1"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: On some carrier-customized devices or specific manufacturer versions, access to this menu may be restricted by the operating system."
            android:textColor="#CFD8DC"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Interactive Launch Button (with testTag in mind) -->
    <Button
        android:id="@+id/launch_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Radio Info"
        android:textSize="16sp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#121212"
        app:backgroundTint="#00E676"
        android:tag="launch_button" />

</LinearLayout>
